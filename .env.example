# ==============================================================
# AdaptiveLearn AI - Environment Configuration
# ==============================================================

# Database
# Default: local PostgreSQL or SQLite fallback (sqlite:///./adaptivelearn.db)
DATABASE_URL=postgresql://deepan@localhost:5432/adaptivelearn
# Example for Docker Compose:
# DATABASE_URL=postgresql://adaptiveuser:adaptivepass@localhost:5432/adaptivelearn

# Security / JWT
SECRET_KEY=replace-this-with-a-secure-random-32-byte-hex-string-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# AI Provider Configuration
# Supported providers: "ollama" (local Gemma), "anthropic", "openai", "mock"
LLM_PROVIDER=ollama
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=gemma4:e4b
OLLAMA_NUM_CTX=8192
OLLAMA_TIMEOUT_S=180

# Alternative Cloud LLM Providers (Optional)
ANTHROPIC_API_KEY=your-anthropic-api-key-here
ANTHROPIC_MODEL=claude-3-5-sonnet-20241022

OPENAI_API_KEY=your-openai-api-key-here
OPENAI_MODEL=gpt-4o

# Embeddings Configuration
# Supported: "deterministic_tfidf" (fast local default), "ollama" (POST /api/embed), "openai"
EMBEDDING_PROVIDER=deterministic_tfidf
OLLAMA_EMBED_MODEL=nomic-embed-text

# Speech-to-Text / Audio Configuration
# Supported: "whisper_api", "mock_stt"
STT_PROVIDER=mock_stt

# Storage Path for Uploaded Materials
UPLOAD_DIR=./uploads

# Frontend App URL (for CORS)
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
NEXT_PUBLIC_API_URL=http://localhost:8000/api
